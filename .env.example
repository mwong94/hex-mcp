# ---------------------------------------------------------------------------
# hex-mcp server configuration
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# app.py does NOT load .env itself. Either run it with
#     uv run --env-file .env app.py
# or point systemd at the file with EnvironmentFile= (see README).
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# Hex API key the server uses to call Hex on your behalf.
# Create one at: Hex → Settings → API keys. Starts with "hxtp_".
HEX_API_KEY=hxtp_replace_me

# Bearer token that MCP *clients* must present to reach this server.
# If unset the server accepts unauthenticated requests — always set it
# when the server is exposed to the internet.
# Generate one with:  openssl rand -hex 32
MCP_API_KEY=replace_me_with_a_long_random_string

# --- Transport (required for the Caddy / HTTP deployment) -------------------

# "stdio" (default) runs as a subprocess for a local client.
# "streamable-http" runs a long-lived HTTP service — what you want behind Caddy.
MCP_TRANSPORT=streamable-http

# Bind address. Use 127.0.0.1 when Caddy runs on the same host so the
# server is not reachable directly from the LAN. Use 0.0.0.0 in a container.
MCP_HOST=127.0.0.1

# Port the server listens on. Must match the Caddy reverse_proxy upstream.
MCP_PORT=8386

# --- Optional ---------------------------------------------------------------

# Override for self-hosted / non-US Hex instances.
# HEX_BASE_URL=https://app.hex.tech/api/v1
